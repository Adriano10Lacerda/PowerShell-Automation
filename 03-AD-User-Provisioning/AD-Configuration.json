{
    "Domain": "BRSPO",
    "DomainController": "",
    "TargetOU": "",
    "SimulationMode": true,
    "OfflineSimulation": true,

    "UserValidation": {
    "FirstName": {
        "MinLength": 2
    },
    "LastName": {
        "MinLength": 2
    }
    },

    "UserPrincipalName": {
    "Enabled": true,
    "Domain": "example.local"
},

    "Simulation": {
        "ExistingSamAccountNames": [
            "silva.maria.ext",
            "silva.maria2.ext",
            "silva.maria3.ext"
        ]
    },

    "SamAccountName": {
        "Enabled": true,
        "MaxLength": 20,
        "RemoveAccents": true
    },

    "DuplicateHandling": {
        "Enabled": true,
        "Strategy": "Increment"
    },

    "LongNamePolicy": {
        "Enabled": true,
        "Strategy": "Manual"
    },

    "UserTypes": {
        "Employee": {
            "Description": "Funcionário",
            "Format": "LastName.FirstName",
            "Suffix": ""
        },
        "Contractor": {
            "Description": "Terceiro",
            "Format": "LastName.FirstName",
            "Suffix": ".ext"
        },
        "Intern": {
            "Description": "Estagiário",
            "Format": "LastName.FirstName",
            "Suffix": ".est"
        }
    }
}